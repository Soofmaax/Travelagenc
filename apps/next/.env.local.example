# Supabase Postgres connection
DATABASE_URL=postgres://postgres:password@YOUR-SUPABASE-HOST:5432/postgres

# Polar checkout
POLAR_ACCESS_TOKEN=your_sandbox_token
SUCCESS_URL=http://localhost:3000/confirmation?checkout_id={CHECKOUT_ID}
RETURN_URL=http://localhost:3000/dashboard

# BetterAuth secrets (optional)
BETTER_AUTH_SECRET=replace_with_secure_random