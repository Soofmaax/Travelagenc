# Example environment variables for Travelagenc
# Copy this file to .env and adjust values for your environment.
#
# Notes:
# - Only variables prefixed with VITE_ are exposed to the client by Vite.
# - For local development, you can leave VITE_API_URL empty and the app will
#   fall back to window.location.origin (browser) or http://localhost (tests).
#
# ⚠️ SECURITY WARNING:
# All VITE_* variables are EXPOSED in the client bundle.
# NEVER put secrets, API keys, or sensitive data here.
# Use a backend/edge function for sensitive operations.

# Base URL of the backend API for client-side requests
# e.g. https://api.example.com or http://localhost:3000
VITE_API_URL=http://localhost:3000

# Monitoring provider (public DSN only; do not include secrets)
# Example: https://PUBLIC_KEY@oXXX.ingest.sentry.io/PROJECT_ID
VITE_SENTRY_DSN=

# Optional defaults (not strictly required by the app, for future usage)
# VITE_DEFAULT_LOCALE=fr
# VITE_ENABLE_MOCK_API=false
# VITE_ANALYTICS_ID=

# ❌ NEVER DO THIS:
# VITE_API_SECRET=xxx      # EXPOSED TO ALL USERS!
# VITE_DATABASE_URL=xxx    # EXPOSED TO ALL USERS!