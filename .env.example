# Example environment variables for Travelagenc
# Copy this file to .env and adjust values for your environment.
#
# Notes:
# - Only variables prefixed with VITE_ are exposed to the client by Vite.
# - For local development, you can leave VITE_API_URL empty and the app will
#   fall back to window.location.origin (browser) or http://localhost (tests).

# Base URL of the backend API for client-side requests
# e.g. https://api.example.com or http://localhost:3000
VITE_API_URL=http://localhost:3000

# Optional defaults (not strictly required by the app, for future usage)
# VITE_DEFAULT_LOCALE=fr
# VITE_ENABLE_MOCK_API=false
# VITE_ANALYTICS_ID=